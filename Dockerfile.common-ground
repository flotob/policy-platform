# Common Ground — read-only presentation app.
# No migrator: policy-web owns the schema; this container only serves.

FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @policy/common-ground build

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app/apps/common-ground/.next/standalone ./
COPY --from=builder /app/apps/common-ground/.next/static ./apps/common-ground/.next/static
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "apps/common-ground/server.js"]
