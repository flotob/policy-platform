{
  "name": "policy-platform",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "pnpm --filter @policy/db push",
    "db:migrate": "pnpm --filter @policy/db migrate"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
